{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "cute: build & run current file",
            "type": "shell",
            "command": "nvcc",
            "args": [
                "-I", "${workspaceFolder}/include",
                "-I", "${workspaceFolder}/tools/util/include",
                "-std=c++17",
                "-Wno-deprecated-gpu-targets",
                "${file}",
                "-o", "${fileDirname}/${fileBasenameNoExtension}",
                "&&",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        }
    ]
}
